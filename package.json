{
  "name": "job-post-notifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Checks ATS job feeds for matching roles and emails a digest of new postings.",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "dry-run": "node --env-file-if-exists=.env --import tsx src/index.ts --dry-run",
    "bootstrap": "node --env-file-if-exists=.env --import tsx src/index.ts --bootstrap",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "discover": "node --env-file-if-exists=.env --import tsx src/discover.ts",
    "events": "node --env-file-if-exists=.env --import tsx src/events/index.ts",
    "events:dry-run": "node --env-file-if-exists=.env --import tsx src/events/index.ts --dry-run",
    "events:bootstrap": "node --env-file-if-exists=.env --import tsx src/events/index.ts --bootstrap",
    "leads": "node --env-file-if-exists=.env --import tsx src/leads/index.ts",
    "leads:dry-run": "node --env-file-if-exists=.env --import tsx src/leads/index.ts --dry-run",
    "leads:bootstrap": "node --env-file-if-exists=.env --import tsx src/leads/index.ts --bootstrap",
    "prospects": "node --env-file-if-exists=.env --import tsx src/prospects/index.ts",
    "prospects:dry-run": "node --env-file-if-exists=.env --import tsx src/prospects/index.ts --dry-run",
    "prospects:bootstrap": "node --env-file-if-exists=.env --import tsx src/prospects/index.ts --bootstrap"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "fast-xml-parser": "^5.11.2",
    "p-limit": "^7.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
